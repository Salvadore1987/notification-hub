# --- Java / JVM ---
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
# Каталоги сборки IntelliJ: только корень проекта и корни модулей.
# Без якорей шаблон `out/` матчил любой каталог `out` на любой глубине,
# в том числе пакет `application/.../port/out` (output-порты гексагона).
/out/
*/out/
# ...кроме `adapter/out` — это каталог исходников (driven-адаптеры), а не сборки IntelliJ.
# Без этой строки любой новый файл под `adapter/out/**` молча не попадает в коммит.
!/adapter/out/

# --- OS ---
.DS_Store
Thumbs.db

